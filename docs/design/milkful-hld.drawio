          <mxGeometry x="835" y="34" width="195" height="44" as="geometry" />
        </mxCell>
        <mxCell id="vpc" value="3 - Amazon VPC  -  Multi-AZ, private subnets, default-deny security groups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#2d6a9f;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#1b4b73;spacingLeft=12;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="1">
