        <mxCell id="d_oss" value="OpenSearch
(search + CQRS)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="sn_data">
          <mxGeometry x="605" y="36" width="175" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_data" value="One database per service; cross-service data via events / APIs only." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=14;" vertex="1" parent="sn_data">
