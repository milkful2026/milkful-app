          <mxGeometry x="15" y="34" width="195" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e_cf" value="CloudFront
+ WAF + Shield" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="edge">
          <mxGeometry x="220" y="34" width="195" height="44" as="geometry" />
        </mxCell>
